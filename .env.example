# Variables à définir dans Vercel (Project → Settings → Environment Variables)

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type « Web application »)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 48)
SESSION_SECRET=

# Redis Upstash (Vercel Marketplace → Upstash Redis). L'intégration crée ces deux variables :
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (équivalent si tu crées la base directement chez Upstash : UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
